{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://mspbackend.onrender.com/api/:path*" },
    { "source": "/uploads/:path*", "destination": "https://mspbackend.onrender.com/uploads/:path*" },
    { "source": "/socket.io/:path*", "destination": "https://mspbackend.onrender.com/socket.io/:path*" },
    { "source": "/((?!api/|uploads/|socket\.io/|assets/).*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    }
  ]
}
