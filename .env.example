# Copy to .env for local development. Vite inlines VITE_* values at build time.

# ---------------------------------------------------------------------------------------------
# API origin used by the browser.
#
# Leave EMPTY (recommended). The app then calls relative /api/... URLs:
#   - dev:  the Vite dev server proxies /api, /uploads and /socket.io to VITE_PROXY_TARGET.
#   - prod: the hosting platform rewrites /api/* to the backend (see vercel.json).
# Same-origin keeps the httpOnly refresh cookie first-party, so the backend can use
# COOKIE_SAMESITE=lax and no third-party-cookie blocking applies (Safari/ITP, Chrome).
#
# Only set this for a cross-site deployment (frontend and API on different sites). The backend
# must then run with COOKIE_SAMESITE=none, COOKIE_SECURE=true and CORS_ORIGIN=<this origin>,
# and browsers that block third-party cookies will lose the session on reload.
VITE_API_URL=

# Backend for the dev proxy (vite / vite preview). Not inlined into the bundle.
VITE_PROXY_TARGET=http://127.0.0.1:5000

# Optional local Vite port
VITE_DEV_PORT=5173

# ---------------------------------------------------------------------------------------------
# Production same-site deployment on Vercel
#
# vercel.json rewrites /api/*, /uploads/* and /socket.io/* to the backend origin. Change the
# destination host there (e.g. https://api.example.com or your Render URL) and keep
# VITE_API_URL empty. Note: Vercel rewrites do not proxy WebSocket upgrades; Socket.IO falls
# back to HTTP long-polling through the rewrite. For real WebSockets serve the API from a
# subdomain of the same site (app.example.com + api.example.com are same-site) and set
# VITE_API_URL=https://api.example.com with COOKIE_SAMESITE=lax and a parent-domain cookie.
